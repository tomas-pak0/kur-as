<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F5F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Kur aš" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="#111111" android:padding="18dp" />
    <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:background="#FFFFFF">
        <TextView android:id="@+id/location" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ieškoma vietos…" android:textSize="19sp" android:textColor="#111111" android:textIsSelectable="true" />
        <TextView android:id="@+id/accuracy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tikslumas: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Adresas: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/device" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Įrenginys: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Baterija: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/gps" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Palydovų ryšys: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/gps_signal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Palydovų signalas: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/network" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ryšys: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/signal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mobilusis signalas: –" android:textSize="15sp" android:paddingTop="8dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="13sp" android:paddingTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="10dp">
            <Button android:id="@+id/center" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Mano vieta" />
            <Button android:id="@+id/share" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Bendrinti" android:enabled="false" />
        </LinearLayout>
        <Button android:id="@+id/live_share" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Gyvas bendrinimas naršyklėje" />
    </LinearLayout>
</LinearLayout>
